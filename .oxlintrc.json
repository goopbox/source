{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "globals": {
    "structuredClone": "readonly"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "rules": {
    "block-scoped-var": "off",
    "class-methods-use-this": "off",
    "complexity": "off",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "id-length": "off",
    "init-declarations": "off",
    "max-classes-per-file": "off",
    "max-depth": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-nested-callbacks": "off",
    "max-params": "off",
    "max-statements": "off",
    "no-alert": "off",
    "no-bitwise": "off",
    "no-continue": "off",
    "no-console": "off",
    "no-eq-null": "off",
    "no-inline-comments": "off",
    "no-magic-numbers": "off",
    "no-negated-condition": "off",
    "no-new": "off",
    "no-nested-ternary": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off",
    "no-ternary": "off",
    "no-undefined": "off",
    "no-underscore-dangle": "off",
    "no-warning-comments": "off",
    "prefer-destructuring": "off",
    "prefer-enum-initializers": "off",
    "prefer-for-of": "off",
    "prefer-global-this": "off",
    "prefer-math-trunc": "off",
    "prefer-number-properties": "off",
    "prefer-spread": "off",
    "prefer-ternary": "off",
    "sort-keys": "off",
    "sort-vars": "off",
    "unicorn/consistent-function-scoping": "off",
    "one-var": "off",
    "unicorn/explicit-length-check": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-lonely-if": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-at": "off",
    "unicorn/prefer-dom-node-append": "off",
    "unicorn/prefer-dom-node-remove": "off",
    "unicorn/prefer-export-from": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/prefer-includes": "off",
    "unicorn/prefer-math-trunc": "off",
    "unicorn/prefer-modern-dom-apis": "off",
    "unicorn/prefer-number-coercion": "off",
    "unicorn/prefer-number-properties": "off",
    "unicorn/prefer-spread": "off",
    "unicorn/prefer-ternary": "off",
    "typescript/ban-types": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/method-signature-style": "off",
    "typescript/no-duplicate-enum-values": "off",
    "typescript/no-unsafe-function-type": "off",
    "typescript/no-wrapper-object-types": "off",
    "typescript/prefer-enum-initializers": "off",
    "typescript/prefer-for-of": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/prefer-string-slice": "off",
    "no-async-await": "off",
    "no-await-in-loop": "off",
    "no-multi-assign": "off",
    "no-new-func": "off",
    "prefer-named-capture-group": "off",
    "require-unicode-regexp": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-await-expression-member": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/prefer-blob-reading-methods": "off",
    "unicorn/prefer-code-point": "off",
    "unicorn/prefer-modern-math-apis": "off",
    "unicorn/prefer-string-replace-all": "off",
    "unicorn/prefer-type-error": "off",
    "unicorn/consistent-existence-index-check": "off",
    "unicorn/explicit-timer-delay": "off",
    "unicorn/prefer-native-coercion-functions": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript/no-dynamic-delete": "off",
    "typescript/no-non-null-assertion": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/no-null": "off",
    "unicorn/no-zero-fractions": "off",
    "unicorn/number-literal-case": "off",
    "oxc/no-optional-chaining": "off",
    "capitalized-comments": "off",
    "default-case": "off",
    "func-names": "off",
    "new-cap": "off",
    "no-array-reduce": "off",
    "no-empty": "off",
    "no-empty-function": "off",
    "no-lone-blocks": "off",
    "prefer-math-min-max": "off",
    "prefer-top-level-await": "off",
    "typescript/no-extraneous-class": "off",
    "typescript/no-import-type-side-effects": "off",
    "unicorn/import-style": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-math-min-max": "off",
    "unicorn/prefer-top-level-await": "off",
    "oxc/no-async-await": "off",
    "no-void": "off",
    "func-style": "off",
    "typescript/parameter-properties": "off"
  }
}
